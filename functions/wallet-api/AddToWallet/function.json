{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "Request",
      "methods": ["post", "options"],
      "route": "AddToWallet"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "Response"
    },
    {
      "type": "table",
      "direction": "out",
      "name": "vCardTable",
      "tableName": "%VCARD_TABLE_NAME%",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
